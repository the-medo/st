#!/usr/bin/env python3
"""Install room voice as the SteamOS user who owns the physical audio devices."""

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

p = argparse.ArgumentParser(description=__doc__)
p.add_argument("--ssh", required=True, help="SSH alias paired to the room bridge")
p.add_argument("--mic", required=True, help="Exact CPAL input name")
p.add_argument("--speaker", required=True, help="Exact CPAL output name")
args = p.parse_args()
if sys.version_info < (3, 11):
    p.error("Use Python 3.11 or later for checksum-verified setup")
root = Path(__file__).resolve().parent
source = root / "runtime" if (root / "runtime").is_dir() else root.parent / "runtime"
binary = (
    root / "st-voice"
    if (root / "st-voice").is_file()
    else root.parent / "target/release/st-voice"
)
models = root / "models.py"
unit = (
    root / "voice.service.example"
    if (root / "voice.service.example").is_file()
    else root.parent / "deploy/steamos/voice.service.example"
)
home = Path.home()
base = home / ".local/lib/stapp"
conf = home / ".config/stapp"
state = home / ".local/share/stapp-room"
cache = home / ".cache/stapp/models"
venv = home / ".local/share/stapp-voice-venv"
for path in (base, conf, state, cache):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
shutil.copy2(binary, base / "st-voice")
(base / "st-voice").chmod(0o755)


def run(*cmd, **opts):
    return subprocess.run(cmd, check=True, **opts)


import json

probe = run(
    "ssh",
    "-T",
    "-o",
    "BatchMode=yes",
    "-o",
    "ConnectTimeout=5",
    args.ssh,
    "stctl",
    "bridge",
    input='{"op":"projects"}\n',
    capture_output=True,
    text=True,
)
if "result" not in json.loads(probe.stdout):
    p.error("Pair the room SSH key first")
assets = root / "audio" if (root / "audio").is_dir() else root.parent / "assistant/audio"
run(sys.executable, str(models), str(cache), str(assets))
import ctypes
try: ctypes.CDLL("libespeak-ng.so.1")
except OSError: p.error("Install eSpeak NG (libespeak-ng.so.1) before starting native speech")
names = run(
    str(base / "st-voice"), "--list", capture_output=True, text=True
).stdout.splitlines()
if "input: " + args.mic not in names:
    p.error("Selected microphone not found. Available: " + ", ".join(names))
if "output: " + args.speaker not in names:
    p.error("Selected output not found. Available: " + ", ".join(names))
settings = {
    "STAPP_DEVICE": "room", "STAPP_SSH": args.ssh,
    "STAPP_MIC": args.mic, "STAPP_SPEAKER": args.speaker,
    "STAPP_CLIENT_STATE": str(state), "STAPP_MODELS": str(cache),
}
(conf / "room.json").write_text(json.dumps(settings, indent=2)+"\n")
(conf / "room.json").chmod(0o600)
units = home / ".config/systemd/user"
units.mkdir(parents=True, exist_ok=True)
shutil.copy2(unit, units / "stapp-room.service")
run("systemctl", "--user", "daemon-reload")
run("systemctl", "--user", "enable", "stapp-room.service")
run("systemctl", "--user", "restart", "stapp-room.service")
