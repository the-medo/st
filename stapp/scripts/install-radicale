#!/usr/bin/env python3
"""Install private Radicale + ST planner user services; do not switch STapp yet."""

import argparse
import json
import os
import secrets
import shutil
import socket
import subprocess
import time
from pathlib import Path

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--port", type=int, default=18642)
args = parser.parse_args()
os.umask(0o077)
home = Path.home()
config = home / ".config/stapp"
data = home / ".local/share/stapp"
install = home / ".local/lib/stapp-planner"
units = home / ".config/systemd/user"
for folder in (config / "radicale", data / "radicale", install, units):
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
settings_file = config / "planner.json"
if not settings_file.exists():
    with socket.socket() as check:
        check.bind(("127.0.0.1", args.port))
    settings = {"url": f"http://127.0.0.1:{args.port}/stapp/planner/",
                "username": "stapp", "password": secrets.token_urlsafe(40), "zone": "Europe/Prague"}
    settings_file.write_text(json.dumps(settings) + "\n")
else:
    settings = json.loads(settings_file.read_text())
    if settings["url"] != f"http://127.0.0.1:{args.port}/stapp/planner/":
        raise SystemExit("Existing planner uses a different port; pass its port explicitly")
settings_file.chmod(0o600)
venv = install / "venv"
if not (venv / "bin/python").exists():
    import sys
    subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True)
subprocess.run([str(venv / "bin/python"), "-m", "pip", "install", "--disable-pip-version-check",
                "-r", str(root / "runtime/planner-requirements.txt")], check=True)
# Pass password on stdin, never on the command line or in install output.
hashed = subprocess.check_output([str(venv / "bin/python"), "-c",
    "import bcrypt,sys; print(bcrypt.hashpw(sys.stdin.buffer.read(), bcrypt.gensalt()).decode())"],
    input=settings["password"].encode()).decode().strip()
users = config / "radicale/users"
users.write_text("stapp:" + hashed + "\n")
users.chmod(0o600)
radicale_config = config / "radicale/config"
radicale_config.write_text(f"""[server]
hosts = 127.0.0.1:{args.port}
[auth]
type = htpasswd
htpasswd_filename = {users}
htpasswd_encryption = bcrypt
[rights]
type = owner_only
[storage]
filesystem_folder = {data / 'radicale/collections'}
[web]
type = none
[logging]
level = warning
""")
shutil.copy2(root / "runtime/planner.py", install / "planner.py")
shutil.copy2(root / "runtime/planner_dave.py", install / "planner_dave.py")


def unit(name, description, command, after, requires=""):
    (units / name).write_text(f"""[Unit]
Description={description}
After={after}
{('Requires=' + requires) if requires else ''}

[Service]
ExecStart={command}
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
WorkingDirectory={data}

[Install]
WantedBy=default.target
""")


unit("stapp-radicale.service", "S.T. private Radicale storage",
     f"{venv}/bin/python -m radicale --config {radicale_config}", "network.target")
unit("stapp-planner.service", "S.T. calendar and task rules",
     f"{venv}/bin/python {install}/planner.py --config {settings_file} --data {data} --socket {data}/planner.sock",
     "stapp-radicale.service", "stapp-radicale.service")
ordering = units / "stapp.service.d"
ordering.mkdir(exist_ok=True)
(ordering / "planner.conf").write_text("[Unit]\nWants=stapp-planner.service\nAfter=stapp-planner.service\n")
subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
subprocess.run(["systemctl", "--user", "enable", "stapp-radicale", "stapp-planner"], check=True)
subprocess.run(["systemctl", "--user", "restart", "stapp-radicale", "stapp-planner"], check=True)
for _ in range(80):
    try:
        with socket.socket(socket.AF_UNIX) as client:
            client.settimeout(1)
            client.connect(str(data / "planner.sock"))
            client.sendall(b'{"action":"list"}\n')
            response = json.loads(client.makefile("rb").readline())
            if "result" in response:
                break
    except (OSError, ValueError):
        pass
    time.sleep(0.25)
else:
    raise SystemExit("Planner not ready; inspect journalctl --user -u stapp-planner -u stapp-radicale")
print(f"Radicale is private on 127.0.0.1:{args.port}; planner ready at {data}/planner.sock")
print("Run scripts/migrate-planner before enabling STAPP_PLANNER_SOCKET for STapp.")
