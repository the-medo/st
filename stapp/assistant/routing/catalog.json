        "stapp/runtime/mcp.py"
      ],
      "tools": [
        "list_records",
        "get_record",
        "save_record",
        "complete_task",
        "delete_record",
        "list_task_projects",
        "save_task_project"
      ],
      "acknowledgement": "I’ll check your planner."
    },
    {
