#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root"
if command -v cargo >/dev/null; then exec cargo "$@"; fi
docker build -q -t stapp-builder -f deploy/build/Dockerfile deploy/build >/dev/null
mkdir -p .cache/cargo
exec docker run --rm --user "$(id -u):$(id -g)" -e CARGO_HOME=/cache -v "$root/.cache/cargo:/cache" -v "$root:/src" stapp-builder cargo "$@"
