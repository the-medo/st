{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "noEmit": true,
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "*.ts"
  ]
}
