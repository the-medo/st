{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "references": [
    {
      "path": "../integrations/ovis/app/shared/vendor/paseo-e2ee"
    }
  ]
}
