diff --git a/packages/frontend/src/lib/st.ts b/packages/frontend/src/lib/st.ts
new file mode 100644
index 0000000..98efcc6
--- /dev/null
+++ b/packages/frontend/src/lib/st.ts
@@ -0,0 +1,42 @@
+/// <reference types="vite/client" />
+
+/** ST is an optional build target. Ordinary DAVe builds retain their own login. */
+export const ST_MODE = import.meta.env.VITE_ST_INTEGRATION === '1';
+export const APP_BASE = ST_MODE ? '/planner' : '/';
+
+let session: Promise<string> | null = null;
+
+async function token(): Promise<string> {
+  if (!session) {
+    session = fetch('/planner/api/st-session', { credentials: 'same-origin' })
+      .then(async (response) => {
+        if (!response.ok) throw new Error('Planner session unavailable');
+        const value = await response.json() as { token?: string };
+        if (!value.token) throw new Error('Planner session unavailable');
+        return value.token;
+      }).catch((error: unknown) => {
+        session = null;
+        throw error;
+      });
+  }
+  return session;
+}
+
+export async function plannerFetch(url: string, options: RequestInit): Promise<Response> {
+  if (!ST_MODE) return fetch(url, options);
+  const path = url.startsWith('/api/') ? APP_BASE + url : url;
+  const write = !['GET', 'HEAD'].includes((options.method ?? 'GET').toUpperCase());
+  const headers = new Headers(options.headers);
+  if (write) headers.set('X-ST-Planner-Token', await token());
+  let response = await fetch(path, { ...options, headers });
+  if (write && response.status === 403) {
+    const body = await response.clone().json().catch(() => null) as { code?: string } | null;
+    if (body?.code === 'ST_SESSION_EXPIRED') {
+      // Only this pre-dispatch rejection is safe to replay after an ST restart.
+      session = null;
+      headers.set('X-ST-Planner-Token', await token());
+      response = await fetch(path, { ...options, headers });
+    }
+  }
+  return response;
+}
