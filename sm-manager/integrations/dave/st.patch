+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+describe('ST subapp transport', () => {
+  beforeEach(() => { vi.resetModules(); vi.stubEnv('VITE_ST_INTEGRATION', '1'); });
+  afterEach(() => { vi.unstubAllGlobals(); vi.unstubAllEnvs(); });
+
+  it('prefixes reads without opening a DAVe login or sending a token', async () => {
+    const fetcher = vi.fn().mockResolvedValue(new Response('{}'));
+    vi.stubGlobal('fetch', fetcher);
+    const { plannerFetch } = await import('../lib/st');
+    await plannerFetch('/api/tasks?q=abc', {});
+    expect(fetcher).toHaveBeenCalledOnce();
+    expect(fetcher.mock.calls[0]![0]).toBe('/planner/api/tasks?q=abc');
+    expect(fetcher.mock.calls[0]![1].headers.has('X-ST-Planner-Token')).toBe(false);
+  });
+
+  it('refreshes only explicit pre-dispatch token rejections and preserves the write', async () => {
+    const fetcher = vi.fn()
+      .mockResolvedValueOnce(Response.json({ token: 'old' }))
+      .mockResolvedValueOnce(Response.json({ code: 'ST_SESSION_EXPIRED' }, { status: 403 }))
+      .mockResolvedValueOnce(Response.json({ token: 'new' }))
+      .mockResolvedValueOnce(Response.json({ ok: true }));
+    vi.stubGlobal('fetch', fetcher);
+    const { plannerFetch } = await import('../lib/st');
+    await plannerFetch('/api/tasks', { method: 'POST', body: '{"task":"x"}' });
+    expect(fetcher).toHaveBeenCalledTimes(4);
+    expect(fetcher.mock.calls[3]![0]).toBe('/planner/api/tasks');
+    expect(fetcher.mock.calls[3]![1].body).toBe('{"task":"x"}');
+    expect(fetcher.mock.calls[3]![1].headers.get('X-ST-Planner-Token')).toBe('new');
+  });
+
+  it('never retries a failed or ambiguous task write', async () => {
+    const fetcher = vi.fn()
+      .mockResolvedValueOnce(Response.json({ token: 'token' }))
+      .mockResolvedValueOnce(Response.json({ error: 'backend failed' }, { status: 503 }));
+    vi.stubGlobal('fetch', fetcher);
+    const { plannerFetch } = await import('../lib/st');
+    expect((await plannerFetch('/api/tasks', { method: 'POST', body: '{}' })).status).toBe(503);
+    expect(fetcher).toHaveBeenCalledTimes(2);
+  });
+
+  it('keeps standalone DAVe requests unchanged', async () => {
+    vi.stubEnv('VITE_ST_INTEGRATION', '');
+    const fetcher = vi.fn().mockResolvedValue(Response.json({}));
+    vi.stubGlobal('fetch', fetcher);
+    const { plannerFetch } = await import('../lib/st');
+    await plannerFetch('/api/auth/login', { method: 'POST' });
+    expect(fetcher).toHaveBeenCalledExactlyOnceWith('/api/auth/login', { method: 'POST' });
+  });
+});
