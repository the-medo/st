{
  "name": "st-console",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "frontend",
    "integrations/ovis/app"
  ],
  "scripts": {
    "build": "bun run --cwd frontend build",
    "typecheck": "bun run --cwd frontend typecheck && bun run --cwd frontend typecheck:gateway",
    "test:unit": "bun test frontend/src services/web-gateway services/ovis",
    "test:browser": "bun tests/v2-browser.ts",
    "build:ovis": "cd integrations/ovis/app && VITE_MEDO_PROJECTS=1 bun run build",
    "test:ovis-browser": "bun tests/ovis-browser.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "playwright-core": "1.49.1"
  },
  "patchedDependencies": {
    "@legendapp/list@3.3.5": "integrations/ovis/app/patches/@legendapp%2Flist@3.3.5.patch",
    "@xterm/xterm@6.0.0": "integrations/ovis/app/patches/@xterm%2Fxterm@6.0.0.patch",
    "@tanstack/highlight@1.0.0": "integrations/ovis/app/patches/@tanstack%2Fhighlight@1.0.0.patch"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "katex": "0.18.9"
  }
}
